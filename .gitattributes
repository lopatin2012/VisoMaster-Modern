# Normalize line endings: store LF in the repository, check out native.
* text=auto eol=lf

# Windows scripts must keep CRLF to run correctly.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets (never diff/merge, never touch line endings).
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.onnx binary
*.pth binary
*.pkl binary
*.engine binary
*.trt binary
*.dfm binary
*.dll binary
*.so binary
*.exe binary
