# --- VisoMaster-Modern fork additions ---
# Local virtual environments
.venv/
venv/
env/

# Model assets are downloaded separately (download_models.py + visomaster-assets release),
# never commit the weights. Keep only the directory placeholders.
/model_assets/**
!/model_assets/**/
!/model_assets/**/.gitkeep

# Portable runtime and downloaded binaries (Python/CUDA/TensorRT/ffmpeg/git-portable)
/dependencies/**
!/dependencies/.gitkeep

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/